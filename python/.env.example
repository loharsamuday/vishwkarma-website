# Telegram Quiz Worker — Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to git

# ══════════════════════════════════════════════════════════════
# MODE SELECTION
# ══════════════════════════════════════════════════════════════
# Set SYNC_API_URL to use HTTP Sync API mode (online hosting).
# Leave it EMPTY to use Direct DB mode (local/VPS).

# HTTP Sync API Mode (for online hosting)
SYNC_API_URL=https://your-website.com/api/tg_quiz/worker_sync.php
WORKER_SECRET=your-worker-secret-key-here

# ── Database (Direct DB Mode only) ───────────────────────────
DB_HOST=localhost
DB_USER=root
DB_PASS=
DB_NAME=Vishwkarma

# ── Security ──────────────────────────────────────────────────
# Must match TG_ENCRYPTION_KEY in config/config.php
TG_ENCRYPTION_KEY=change-this-to-32-char-random-key!

# ── Worker Settings ───────────────────────────────────────────
POLL_INTERVAL_SECONDS=5
MAX_RETRIES=3
RETRY_DELAY_SECONDS=10
