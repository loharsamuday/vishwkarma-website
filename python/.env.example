# Telegram Quiz Worker — Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to git

# ── Database ──────────────────────────────────────────
DB_HOST=localhost
DB_USER=root
DB_PASS=
DB_NAME=Vishwkarma

# ── Security ──────────────────────────────────────────
# Must be exactly 32+ characters. Use a random string.
# Must MATCH the TG_ENCRYPTION_KEY defined in config/config.php
TG_ENCRYPTION_KEY=your-super-secret-32-char-key-here

# ── Worker Settings ───────────────────────────────────
# How often (seconds) worker checks for new questions to send
POLL_INTERVAL_SECONDS=5
# Max retries before skipping a failed question
MAX_RETRIES=3
# Seconds to wait before retrying a failed question
RETRY_DELAY_SECONDS=10
