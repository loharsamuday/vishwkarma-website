<IfModule mod_rewrite.c>
    RewriteEngine On

    # Allow direct access to existing files and directories
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Directly serve extensionless PHP files (e.g. /matrimony -> matrimony.php, /blogs -> blogs.php)
    RewriteCond %{DOCUMENT_ROOT}/%{REQUEST_URI}\.php -f [OR]
    RewriteCond %{REQUEST_FILENAME}\.php -f
    RewriteRule ^([a-zA-Z0-9_-]+)/?$ $1.php [QSA,L]

    # Sitemap route
    RewriteRule ^sitemap\.xml$ sitemap_generator.php [L]

    # Route everything else to router.php
    RewriteRule ^(.*)$ router.php?url=$1 [QSA,L]
</IfModule>
